# Vector MCP configuration for FAST workspace variant (copy to .env.fast or .env)
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5444
VECTOR_DB_NAME=exegetos_fast
VECTOR_DB_USER=vector_admin
VECTOR_DB_PASSWORD=change_me

QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6345
QDRANT_GRPC_PORT=6346

# Optional embedding HTTP endpoint (custom service)
EMBEDDING_ENDPOINT=http://localhost:8090/embed
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_QUERY_PREFIX=Instruct: Given a query, retrieve relevant passages.

# Optional Engram settings (recommended when EngramLookup is used)
ENGRAM_PARAMS_PATH=engine/tools/exevision/Engram/engram_params.json
ENGRAM_TOKENIZER_DIR=engine/tools/exevision/Models/Qwen3-VL-2B-Instruct

# Optional admin delete token (only needed to enable DeleteDocument)
VECTOR_DELETE_TOKEN=
