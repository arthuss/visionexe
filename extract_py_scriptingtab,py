# bone_hierarchy_dump.py
# Usage:
#   blender your_scene.blend --background --python bone_hierarchy_dump.py -- \
#       --armature "ArmatureName" \
#       --armature "OtherArmature" \
#       --dump-joints \
#       --bvh "/path/to/skeleton.bvh" \
#       --profile "/path/to/profile.3dxProfile"
#
# If you omit --armature, it dumps ALL armatures found.

import bpy
import sys
import os
import re

# -----------------------------
# Helpers: CLI args
# -----------------------------
def get_args_after_double_dash():
    argv = sys.argv
    if "--" in argv:
        return argv[argv.index("--") + 1 :]
    return []

def parse_args(args):
    out = {
        "armatures": [],
        "dump_joints": False,
        "bvh": None,
        "profile": None,
    }
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--armature":
            i += 1
            if i < len(args):
                out["armatures"].append(args[i])
        elif a == "--dump-joints":
            out["dump_joints"] = True
        elif a == "--bvh":
            i += 1
            if i < len(args):
                out["bvh"] = args[i]
        elif a == "--profile":
            i += 1
            if i < len(args):
                out["profile"] = args[i]
        i += 1
    return out

# -----------------------------
# Dump Armature bone hierarchy
# -----------------------------
def dump_armature_bones(arm_obj: bpy.types.Object):
    arm = arm_obj.data
    bones = arm.bones  # edit-bones equivalent in rest pose

    # children map
    children = {}
    roots = []
    for b in bones:
        children.setdefault(b.name, [])
    for b in bones:
        if b.parent:
            children.setdefault(b.parent.name, []).append(b.name)
        else:
            roots.append(b.name)

    # stable ordering (by name)
    for k in children:
        children[k].sort()
    roots.sort()

    def rec(name, depth=0):
        b = bones.get(name)
        if not b:
            return
        indent = "  " * depth
        # head/tail are in armature space (rest pose)
        h = b.head_local
        t = b.tail_local
        print(f"{indent}- {name}  head={tuple(round(x,6) for x in h)}  tail={tuple(round(x,6) for x in t)}")
        for c in children.get(name, []):
            rec(c, depth + 1)

    print(f"\n=== ARMATURE: {arm_obj.name} ===")
    for r in roots:
        rec(r, 0)

# -----------------------------
# Dump "joint" OBJECT hierarchy
# (SAM3 sometimes imports joints as empties/objects with parenting)
# -----------------------------
def dump_joint_objects():
    objs = list(bpy.context.scene.objects)

    # Heuristic: objects named "joint" / "Joint_" etc.
    joint_objs = [o for o in objs if re.search(r"\bjoint\b|^joint_|^Joint_", o.name)]
    if not joint_objs:
        print("\n(No joint-like objects found. Skipping --dump-joints.)")
        return

    # children map for objects
    children = {}
    roots = []
    s = set(joint_objs)
    for o in joint_objs:
        children.setdefault(o.name, [])
    for o in joint_objs:
        if o.parent and o.parent in s:
            children[o.parent.name].append(o.name)
        else:
            roots.append(o.name)

    for k in children:
        children[k].sort()
    roots.sort()

    def rec(name, depth=0):
        o = bpy.context.scene.objects.get(name)
        if not o:
            return
        indent = "  " * depth
        loc = o.matrix_world.translation
        print(f"{indent}- {name}  world_loc={tuple(round(x,6) for x in loc)}  type={o.type}")
        for c in children.get(name, []):
            rec(c, depth + 1)

    print("\n=== JOINT OBJECT HIERARCHY (heuristic) ===")
    for r in roots:
        rec(r, 0)

# -----------------------------
# Parse BVH hierarchy (names + parent/child)
# -----------------------------
def dump_bvh_hierarchy(path):
    if not path or not os.path.exists(path):
        print(f"\n(BVH not found: {path})")
        return

    print(f"\n=== BVH HIERARCHY: {path} ===")
    lines = open(path, "r", errors="ignore").read().splitlines()

    # Very small BVH hierarchy parser (ignores MOTION)
    stack = []  # (joint_name, depth)
    depth = 0
    i = 0
    in_hierarchy = False
    while i < len(lines):
        line = lines[i].strip()
        if line == "HIERARCHY":
            in_hierarchy = True
            i += 1
            continue
        if line == "MOTION":
            break
        if not in_hierarchy:
            i += 1
            continue

        if line.startswith("ROOT ") or line.startswith("JOINT "):
            name = line.split(None, 1)[1].strip()
            indent = "  " * depth
            print(f"{indent}- {name}")
            stack.append(name)
            i += 1
            continue
        if line.startswith("End Site"):
            indent = "  " * depth
            print(f"{indent}- End Site")
            i += 1
            continue

        if line.startswith("{"):
            depth += 1
            i += 1
            continue
        if line.startswith("}"):
            depth = max(0, depth - 1)
            if stack:
                stack.pop()
            i += 1
            continue

        # ignore OFFSET/CHANNELS etc
        i += 1

# -----------------------------
# Parse Reallusion .3dxProfile BoneMap
# -----------------------------
def dump_3dxprofile_bonemap(path):
    if not path or not os.path.exists(path):
        print(f"\n(.3dxProfile not found: {path})")
        return

    print(f"\n=== 3DXPROFILE BONEMAP: {path} ===")
    txt = open(path, "r", errors="ignore").read()

    # Find [BoneMap] section (typical)
    m = re.search(r"(?ms)^\[BoneMap\]\s*(.*?)(^\[|\Z)", txt)
    if not m:
        print("(No [BoneMap] section found in this profile.)")
        return

    section = m.group(1)
    pairs = []
    for raw in section.splitlines():
        raw = raw.strip()
        if not raw or raw.startswith(";") or raw.startswith("#"):
            continue
        if "=" in raw:
            left, right = raw.split("=", 1)
            left = left.strip()
            right = right.strip()
            pairs.append((left, right))

    # print a few nicely
    for left, right in pairs:
        print(f"- {left}  ->  {right}")

# -----------------------------
# Main
# -----------------------------
def main():
    cfg = parse_args(get_args_after_double_dash())

    # Armatures
    all_armatures = [o for o in bpy.context.scene.objects if o.type == "ARMATURE"]
    if cfg["armatures"]:
        wanted = set(cfg["armatures"])
        armatures = [o for o in all_armatures if o.name in wanted]
    else:
        armatures = all_armatures

    if not armatures:
        print("No armatures found in scene.")
    else:
        for a in sorted(armatures, key=lambda x: x.name.lower()):
            dump_armature_bones(a)

    # Optional joint objects dump
    if cfg["dump_joints"]:
        dump_joint_objects()

    # Optional BVH dump
    if cfg["bvh"]:
        dump_bvh_hierarchy(cfg["bvh"])

    # Optional 3dx profile bonemap
    if cfg["profile"]:
        dump_3dxprofile_bonemap(cfg["profile"])

if __name__ == "__main__":
    main()
